#!/bin/sh
# A C compiler for x86_64 Windows on any host, for type-checking C-backed
# crates (ring, zstd-sys) from a Mac. zig carries its own mingw headers.
# cc-rs adds --target=x86_64-pc-windows-msvc, a triple zig cannot parse,
# so that one argument is dropped and zig's own spelling used instead.
for arg in "$@"; do
  shift
  case "$arg" in
    --target=*) ;;
    *) set -- "$@" "$arg" ;;
  esac
done
exec zig cc -target x86_64-windows-gnu "$@"
