package krate:store@0.1.0;

/// Durable key-value storage scoped to one application.
///
/// Every app that remembers anything -- a window size, a signed-in name, a
/// list of items, the last folder you opened -- needs this, and today the only
/// way to have it is `fs.read` and `fs.write` plus hand-written parsing. That
/// costs an app real code to get right, and it makes the permission prompt say
/// "read files in checklist" when the honest answer is "remember your settings".
///
/// The store is the app's own. It is not a path on the user's computer: the app
/// never learns where the data lives and cannot name a location outside it, so
/// granting storage cannot become a way to read the user's documents. That is
/// why this is a separate capability from the filesystem rather than a
/// convenience built on top of one.
interface kv {
  /// Error returned by a store operation.
  variant store-error {
    /// The app did not receive the `store.kv` capability.
    denied,
    /// The key was empty, too long, or used unsupported syntax.
    invalid-key,
    /// The value is larger than the runtime's bounded write limit.
    too-large,
    /// The store could not be read or written.
    io(string),
  }

  /// Read one value. A key that was never set reads as `none` rather than an
  /// error, because "nothing saved yet" is the normal first run.
  get: func(key: string) -> result<option<list<u8>>, store-error>;

  /// Write one value, replacing whatever was there.
  set: func(key: string, value: list<u8>) -> result<_, store-error>;

  /// Remove one key. Removing a key that is not present succeeds: the caller
  /// wanted it gone, and it is gone.
  delete: func(key: string) -> result<_, store-error>;

  /// Every key currently set, in sorted order so a listing is stable across
  /// runs and across operating systems.
  keys: func() -> result<list<string>, store-error>;

  /// Remove everything. Separate from `delete` because "forget all of it" is a
  /// deliberate action an app should have to name.
  clear: func() -> result<_, store-error>;
}

/// A real database, scoped to one application.
///
/// The key-value store above holds settings and small collections. An app with
/// a growing list, a search box, or anything it needs to query rather than read
/// whole needs a database, and rewriting one on top of files is where a port
/// stops being worth doing.
///
/// The app gets SQL, not a file. It never learns a path, never opens a
/// connection to somewhere else, and cannot attach another database, so this
/// stays a capability the runtime fully mediates rather than a hole in the
/// filesystem boundary.
interface sql {
  /// One value in a row or a query parameter.
  ///
  /// A closed set rather than an open one: every value crossing the boundary
  /// has a known shape, so the host never has to interpret app-supplied text as
  /// a type declaration.
  variant value {
    /// SQL NULL.
    null,
    /// A 64-bit signed integer.
    integer(s64),
    /// A double-precision float.
    real(f64),
    /// Text.
    text(string),
    /// Arbitrary bytes.
    blob(list<u8>),
  }

  /// Error returned by a database operation.
  variant sql-error {
    /// The app did not receive the `store.sql` capability.
    denied,
    /// The statement could not be parsed or refers to something missing.
    invalid-statement(string),
    /// The statement is one this interface does not permit, such as attaching
    /// another database or reading a file from the host.
    forbidden(string),
    /// The result, or the database as a whole, exceeded its bound.
    too-large,
    /// The database could not be read or written.
    io(string),
  }

  /// One returned row, in the column order of the query.
  record row {
    /// The row's values, in the column order of the query.
    values: list<value>,
  }

  /// The result of a query.
  record query-result {
    /// Column names in the order the values appear, so a caller can address
    /// results by name without a second round trip.
    columns: list<string>,
    /// The rows the query matched, in the order the database returned them.
    rows: list<row>,
  }

  /// Run a statement that returns rows.
  ///
  /// Parameters are bound, never substituted into the text, so an app cannot
  /// build an injection out of its own user's input by accident.
  query: func(statement: string, params: list<value>) -> result<query-result, sql-error>;

  /// Run a statement that changes data, returning the number of rows affected.
  execute: func(statement: string, params: list<value>) -> result<u64, sql-error>;

  /// Run several statements as one unit, so a half-applied change cannot
  /// survive a crash. Any failure rolls the whole batch back.
  transaction: func(statements: list<string>) -> result<_, sql-error>;
}

/// Secrets an app keeps for itself, such as a sign-in token.
///
/// Without this an app that signs in has to write its token to a plain file
/// behind an `fs.write` grant, which puts the token beside the user's documents
/// in the permission prompt and in the clear on disk.
///
/// Secrets are encrypted at rest with a key the runtime derives per machine and
/// per app, so a backup or a copied file does not carry usable secrets to
/// another computer, and one app cannot read another's. This is not the
/// operating system's keychain: Linux's requires a running daemon that servers
/// and minimal desktops do not have, and an app that works on one computer and
/// fails on another is the failure Krate exists to remove. It protects secrets
/// at rest, not from code already running as the same user.
interface secret {
  /// Error returned by a secret operation.
  variant secret-error {
    /// The app did not receive the `store.secret` capability.
    denied,
    /// The name was empty, too long, or used unsupported syntax.
    invalid-name,
    /// The secret is larger than the runtime's bounded limit.
    too-large,
    /// The secret store could not be read or written.
    io(string),
  }

  /// Read one secret. A name that was never set reads as `none`.
  get: func(name: string) -> result<option<list<u8>>, secret-error>;

  /// Store one secret, replacing whatever was there.
  set: func(name: string, secret: list<u8>) -> result<_, secret-error>;

  /// Remove one secret. Removing one that is absent succeeds.
  delete: func(name: string) -> result<_, secret-error>;

  /// The names of stored secrets, never their values, so a listing cannot
  /// become a way to read everything at once.
  names: func() -> result<list<string>, secret-error>;
}

/// A key-value bucket shared between the machines that hold its invite code.
///
/// This is how an app becomes a household app -- a shopping list two people
/// see, a meal plan a family edits -- without the app author running a
/// backend and without anyone creating an account. The person who creates a
/// share gets a ten-character code; anyone they give it to sees the same
/// data. Possession of the code IS the membership, exactly like a shared
/// album link, and the consent dialog says so in those words.
///
/// The store is local-first: reads and writes always work against the copy
/// on this machine, `sync` exchanges changes with krate.tech when the
/// network allows, and the newest write of a key wins. Bounded like a list,
/// not a database: hundreds of keys, kilobytes per value.
interface shared {
  /// Error returned by a shared-store operation.
  variant shared-error {
    /// The app did not receive the `store.shared` capability.
    denied,
    /// No share has been created or joined yet.
    not-joined,
    /// The invite code was not a share that exists.
    no-such-share,
    /// The key was empty, too long, or used unsupported syntax.
    invalid-name,
    /// The value is larger than the runtime's bounded limit.
    too-large,
    /// The store could not be read or written.
    io(string),
  }

  /// The invite code of this app's share, or `none` before create or join.
  code: func() -> result<option<string>, shared-error>;

  /// Create a fresh share and return its invite code. Requires the network;
  /// the code is minted by krate.tech so it is unique.
  create: func() -> result<string, shared-error>;

  /// Join an existing share by its invite code. Local keys are kept and
  /// merged: the newest write of each key wins.
  join: func(code: string) -> result<_, shared-error>;

  /// Leave the share: keeps the local copy, stops syncing, forgets the code.
  leave: func() -> result<_, shared-error>;

  /// Read one key from the local copy. Never touches the network.
  get: func(key: string) -> result<option<list<u8>>, shared-error>;

  /// Write one key locally and queue it for sync.
  set: func(key: string, value: list<u8>) -> result<_, shared-error>;

  /// Delete one key locally and queue the removal for sync.
  delete: func(key: string) -> result<_, shared-error>;

  /// The keys present in the local copy.
  keys: func() -> result<list<string>, shared-error>;

  /// Exchange changes with krate.tech now: push queued writes, pull what
  /// other machines wrote. Returns `true` when the local copy changed, so
  /// the app knows to redraw. Offline is not an error -- it returns `false`
  /// and the queue keeps waiting. Call it on launch, after writes, and on a
  /// timer of ten seconds or more; the host rate-limits anything faster.
  sync: func() -> result<bool, shared-error>;
}

/// Storage shared between one publisher's apps, in a named group.
///
/// A budget app and a reports app from the same publisher can keep one set
/// of numbers without either running a server. Sharing is the publisher's
/// decision, not an accident of two apps choosing the same id: the
/// publisher signs a list naming the apps that may use the group, and an
/// app the newest list does not name is refused -- `not-a-member` -- even
/// when the person granted `store.group:<name>`. Leaving an app out of the
/// next list removes it.
///
/// Like `kv`, the app names keys and never a location, and the same limits
/// apply. Reads see what the other members wrote; the last write of a key
/// wins.
interface group {
  /// Error returned by a group operation.
  variant group-error {
    /// The app did not receive `store.group` for this group.
    denied,
    /// The publisher's newest list on this machine does not name this app,
    /// or no list for the group is known here yet, or the app is unsigned.
    not-a-member,
    /// The key was empty, too long, or used unsupported syntax.
    invalid-key,
    /// The value is larger than the runtime's bounded write limit.
    too-large,
    /// The store could not be read or written.
    io(string),
  }

  /// Read one value from the group.
  get: func(group: string, key: string) -> result<option<list<u8>>, group-error>;

  /// Store one value in the group.
  set: func(group: string, key: string, value: list<u8>) -> result<_, group-error>;

  /// Remove one value. Removing something absent succeeds.
  delete: func(group: string, key: string) -> result<_, group-error>;

  /// Every key in the group, sorted.
  keys: func(group: string) -> result<list<string>, group-error>;
}

/// Data an organisation's own app keeps for the whole team, with no backend.
///
/// An internal app -- an expenses list, a stock count, a rota -- needs one
/// set of records everyone in the team sees. On the web that means a server,
/// a database and sign-in code, and those are where AI-built apps go wrong.
/// Here the organisation's own store on Krate's hub holds the records, per
/// app, and the runtime handles who may see them: the app has no server,
/// no database to secure and no sign-in code.
///
/// Only an organisation's private app uses it: one whose bundle carries the
/// organisation's mark under a signature that holds, opened as a release the
/// organisation approved and has not withdrawn, by a signed-in member inside
/// that release's audience. Anything else is `not-an-org-app` or `refused`.
/// The app id is the signed manifest's, so every version of the app shares
/// its data and no other app reaches it.
///
/// End to end encrypted. The hub stores ciphertext only: each field is
/// sealed on the device with a key derived from the organisation's key,
/// which exists only on its members' devices (passed device to device, and
/// replaced when someone is removed). The hub sees which app, how many
/// records and fields and their sizes, when people sync, and the clock
/// stamps it merges by; never a collection name, an id, a field name or a
/// value. The sealed data is in the organisation's export and deleted with
/// the organisation. A device that does not hold the key yet keeps its
/// writes waiting, as it does offline.
///
/// Offline first. Every call works on this device's copy and never waits
/// for the network. The runtime exchanges changes with the organisation's
/// store in the background every five seconds while the app is open and
/// once when it closes; `sync` asks for an exchange now, and `status` says
/// where this device stands. Being offline is never an error.
///
/// Records merge per field: two people editing different fields of one
/// record both keep their change, and for one field the later edit wins by
/// a hybrid logical clock (wall time, a counter and the device), so a
/// device with a wrong clock cannot win by claiming a later time. A delete
/// is kept for 30 days so an offline device cannot bring the record back.
///
/// Limits, enforced on the device and by the hub:
/// - a collection name, record id or field name is 1 to 128 bytes with no
///   control characters;
/// - a record is at most 64 KiB, counting its fields' names and values
///   (text and bytes by length, a number 8, a flag 1);
/// - one app's data in one organisation is at most 50 MiB by default,
///   counting every stored field and its bookkeeping;
/// - `records` answers at most 200 records a page;
/// - `sync` called more often than every two seconds, with nothing of this
///   device's waiting to go up, answers from this device without reaching
///   the hub.
interface org {
  /// One field's value.
  variant value {
    /// No value: writing `null` to a field removes that field.
    null,
    /// UTF-8 text.
    text(string),
    /// A number. It must be finite.
    number(f64),
    /// True or false.
    boolean(bool),
    /// Raw bytes.
    bytes(list<u8>),
  }

  /// One record, as this device holds it.
  record entry {
    /// The record's id in its collection.
    id: string,
    /// Its fields, sorted by name. A field set to `null` is not listed.
    fields: list<tuple<string, value>>,
    /// Who changed it last, as the organisation names them: a GitHub
    /// login or an email address.
    changed-by: string,
    /// When it was changed last: milliseconds since the Unix epoch.
    changed-at: u64,
  }

  /// A place in a collection's changes. Opaque: keep it and hand it back.
  type cursor = string;

  /// One page of `records`.
  record page {
    /// Records, the least recently changed first.
    entries: list<entry>,
    /// Ids of records removed since the cursor; empty when listing from
    /// the start.
    removed: list<string>,
    /// Pass this as `since` for the next page, or later to get only what
    /// changed after this listing.
    next: cursor,
    /// More are waiting now: call again with `next`.
    more: bool,
  }

  /// What one sync did.
  record sync-state {
    /// The organisation's store was reached. False while offline, which
    /// is not an error.
    online: bool,
    /// This device's copy changed: show it again.
    changed: bool,
    /// Changes made here that have not reached the organisation yet.
    pending: u32,
    /// When the organisation last accepted this device's changes, in
    /// milliseconds since the Unix epoch; `none` before the first time.
    last-synced: option<u64>,
  }

  /// Where this device stands with the organisation's store.
  enum link {
    /// The last exchange reached the organisation and nothing made here
    /// is waiting to go up.
    synced,
    /// An exchange is under way or due: changes made here are on their
    /// way, or this run has not reached the organisation yet.
    syncing,
    /// The last try did not reach the organisation. Changes wait here.
    offline,
    /// This device does not hold the organisation's key yet. Changes wait
    /// here; another member's computer passes the key on by itself the next
    /// time it has Krate open.
    waiting-for-key,
  }

  /// What `status` answers.
  record standing {
    /// Where this device stands.
    link: link,
    /// Changes made here that have not reached the organisation yet.
    pending: u32,
    /// When this device last reached the organisation's store, reading or
    /// sending, in milliseconds since the Unix epoch; `none` before the
    /// first time this run.
    reached-at: option<u64>,
    /// The organisation's name, for words such as "someone in Acme".
    org: string,
  }

  /// The signed-in person, as the organisation knows them, so an app can
  /// say who added something.
  record member {
    /// Their name in the organisation: a GitHub login or an email address.
    name: string,
    /// Their role: owner, admin, developer, reviewer or recipient.
    role: string,
    /// The organisation's name.
    org: string,
  }

  /// Why the organisation refused.
  record refusal {
    /// A stable reason: `removed`, `not-a-member`, `not-in-audience`,
    /// `release-withdrawn`, `not-released`, `not-signed-in` or
    /// `org-closed`.
    reason: string,
    /// Plain words to show the person, saying what to do next.
    message: string,
  }

  /// Error returned by an organisation-data operation.
  variant org-error {
    /// The app did not receive the `store.org` capability.
    denied,
    /// This is not an organisation's private app opened as its release, so
    /// it has no organisation data.
    not-an-org-app,
    /// A name, id or value broke a limit above; the words say which.
    invalid(string),
    /// The record would be larger than 64 KiB.
    too-large,
    /// The app's data in the organisation is full.
    over-quota,
    /// The organisation refused this person or this version of the app.
    /// Its data is not served for the rest of the run.
    refused(refusal),
    /// This host cannot reach an organisation's store: a browser tab.
    unsupported,
    /// This device's copy could not be read or written.
    io(string),
  }

  /// Write the named fields of one record, creating it if needed. Fields
  /// not named keep their values; a field given `null` is removed.
  put: func(collection: string, id: string, fields: list<tuple<string, value>>) -> result<_, org-error>;

  /// Read one record. A record never written, or deleted, is `none`.
  get: func(collection: string, id: string) -> result<option<entry>, org-error>;

  /// Delete one record everywhere. Deleting one that is not there
  /// succeeds.
  delete: func(collection: string, id: string) -> result<_, org-error>;

  /// The records in a collection: from the start with `none`, or what
  /// changed after a cursor an earlier page gave.
  records: func(collection: string, since: option<cursor>) -> result<page, org-error>;

  /// Ask for an exchange with the organisation now: push this device's
  /// changes, pull everyone else's. In a windowed app it never waits: the
  /// exchange runs in the background and this answers at once with where
  /// this device stands, and `changed` is said by a later call once the
  /// exchange brings something. In a command-line app it waits for the
  /// exchange.
  sync: func() -> result<sync-state, org-error>;

  /// The signed-in person and their role, once a sync has reached the
  /// organisation with its key; `none` before that.
  who: func() -> result<option<member>, org-error>;

  /// Where this device stands, from this device: it never waits and never
  /// reaches the network. Cheap enough to ask every frame.
  status: func() -> result<standing, org-error>;
}
