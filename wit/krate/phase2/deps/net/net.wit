package krate:net@0.1.0;

/// Shared network request, response, and error types.
interface types {
  /// HTTP method for Phase 2 client requests.
  enum http-method {
    /// HTTP GET.
    get,
    /// HTTP POST.
    post,
    /// HTTP PUT.
    put,
    /// HTTP DELETE.
    delete,
    /// HTTP PATCH.
    patch,
    /// HTTP HEAD.
    head,
    /// HTTP OPTIONS.
    options,
  }

  /// One HTTP header field.
  record header {
    /// Header name.
    name: string,
    /// Header value.
    value: string,
  }

  /// Buffered HTTP request shape.
  record request {
    /// Request method.
    method: http-method,
    /// Absolute request URL.
    url: string,
    /// App-provided headers. Host-controlled transport headers are rejected.
    headers: list<header>,
    /// Buffered request body.
    body: list<u8>,
    /// Optional timeout in milliseconds for this request.
    timeout-millis: option<u32>,
  }

  /// Buffered HTTP response shape.
  record response {
    /// Numeric HTTP status code.
    status: u16,
    /// Response headers accepted by the host adapter.
    headers: list<header>,
    /// Buffered response body.
    body: list<u8>,
  }

  /// What became of a request started with `http-client.begin`.
  ///
  /// One shape rather than a result, because "not finished yet" is a normal
  /// answer here and not an error. `pending` is the only non-terminal
  /// variant: the other three retire the handle.
  variant fetch-status {
    /// Still working. Draw a frame and ask again.
    pending,
    /// Finished, with the response.
    ready(response),
    /// Finished, badly. The same errors `fetch` can return.
    failed(net-error),
    /// This handle was never issued, or has already been answered or
    /// cancelled. Distinct from `failed` so a double-poll is not mistaken
    /// for a network problem.
    unknown-handle,
  }

  /// Network error shape returned by HTTP client calls.
  variant net-error {
    /// URL syntax or unsupported Phase 2 URL shape.
    invalid-url,
    /// Hostname resolution failed.
    dns-failure(string),
    /// Socket connection failed.
    connect-failure(string),
    /// TLS setup failed. HTTPS is not yet implemented in the first Phase 2 adapter slice.
    tls-failure(string),
    /// Request timed out.
    timeout,
    /// Response exceeded the configured body-size limit.
    body-too-large,
    /// Capability policy denied the request before socket access.
    permission-denied,
    /// Response framing or protocol parsing failed.
    protocol(string),
    /// Host-specific network error text.
    other(string),
  }
}

/// HTTP client calls for CLI components.
/// Buffered HTTP requests to hosts the person allowed.
///
/// **Redirects are not followed.** A 3xx comes back with its `location` header
/// for the app to act on, and following it means making another request -- one
/// that is checked against `net.connect` for the new host.
///
/// That is deliberate rather than unfinished. `net.connect` is granted per
/// host, so a client that followed redirects itself would let a granted
/// `api.example.com` send the app's request anywhere it liked, with the
/// person's permission prompt saying only "api.example.com". Leaving the
/// decision to the app keeps every host the request reaches one the person
/// actually approved.
interface http-client {
  use types.{request, response, net-error, fetch-status};

  /// Perform a simple GET request and return only the response body.
  get: func(url: string) -> result<list<u8>, net-error>;
  /// Perform a buffered HTTP request and return status, headers, and body.
  fetch: func(req: request) -> result<response, net-error>;

  /// Start a request and return immediately with a handle.
  ///
  /// The work happens on a host thread while the guest keeps its own loop
  /// turning, so the app can draw a spinner, animate, answer a click, or
  /// offer a cancel button while the network is slow. This is the whole
  /// point: a blocking `fetch` against a server that stalls three seconds
  /// froze a real app for the full three seconds (K-101).
  ///
  /// The capability check happens here, at `begin`, exactly as it does for
  /// `fetch` -- a handle is only ever issued for a host the person granted.
  /// Failing that check fails this call, not the later `poll`.
  ///
  /// The handle is valid until `poll` returns a terminal answer or `cancel`
  /// is called. Handles do not survive the run.
  begin: func(req: request) -> result<u64, net-error>;

  /// Ask what happened to a request started with `begin`.
  ///
  /// Returns immediately, always. `pending` means keep going -- draw a
  /// frame and ask again later. Anything else is terminal and retires the
  /// handle, so polling a finished request answers `unknown-handle`.
  poll: func(handle: u64) -> fetch-status;

  /// Abandon a request. The handle is retired whether or not the work had
  /// finished, and any response already in flight is dropped.
  ///
  /// This is what a cancel button calls. It is safe on a handle that has
  /// already been retired.
  cancel: func(handle: u64);
}

/// Live two-way connections: WebSocket, ws:// and wss://.
///
/// The permission story is the same one HTTP has: opening a connection is a
/// `net.connect` to that host and port, checked at `open` on the calling
/// thread, before anything dials. There is no separate capability to declare
/// -- an app granted `net.connect:example.com:443` may fetch from it and may
/// hold a socket to it, which is the same promise to the person either way.
///
/// Everything here returns immediately. The connection lives on a host
/// thread; the guest polls for events from its own loop exactly as it polls
/// `http-client` fetches, so a stalled server can never freeze a frame.
interface ws {
  use types.{net-error};

  /// One message, either direction.
  variant ws-message {
    /// UTF-8 text.
    text(string),
    /// Raw bytes.
    binary(list<u8>),
  }

  /// What `poll` found.
  variant ws-event {
    /// Nothing new. The normal answer; keep drawing and ask later.
    pending,
    /// The handshake finished; the connection is live. Reported once.
    opened,
    /// The server sent a message.
    message(ws-message),
    /// The connection closed cleanly. Terminal; the handle is retired.
    closed,
    /// The connection failed, with the reason. Terminal; the handle is
    /// retired.
    failed(string),
    /// Never opened, or already closed, cancelled, or retired.
    unknown-handle,
  }

  /// Open a connection to a `ws://` or `wss://` URL and return a handle.
  ///
  /// The capability check happens here: the URL's host and port must be
  /// covered by a `net.connect` grant, exactly as for a fetch. `wss://`
  /// verifies certificates, always; there is no way to ask it not to.
  open: func(url: string) -> result<u64, net-error>;

  /// Queue one message to send. Returns immediately; the host thread
  /// delivers it in order. Sending on a connection that has not finished
  /// opening queues the message for when it has.
  send: func(handle: u64, message: ws-message) -> result<_, net-error>;

  /// Ask for the next event. Returns immediately, always; `pending` is the
  /// normal answer. Messages arrive in order. A terminal event retires the
  /// handle.
  poll: func(handle: u64) -> ws-event;

  /// Close the connection politely. Safe on a handle already retired; the
  /// final `closed` event still arrives through `poll`.
  close: func(handle: u64);
}

/// TCP and UDP for an app that speaks its own protocol (IC-935): a game's
/// client and server, QUIC, a chat protocol, a database driver.
///
/// The permission story is `net.connect`'s, exactly: a connection to a host
/// and port, and every datagram sent to one, is judged against the person's
/// `net.connect:<host>:<port>` grants before any socket exists, the same
/// judgment a fetch gets. There is no separate capability to declare. An
/// address an app looked up here stands for the name it looked up, so a grant
/// for `play.example.com:14004` covers the address that name resolved to and
/// no other. A UDP socket hears datagrams only from addresses it has sent to:
/// binding one is not an open door.
///
/// Everything here returns immediately. Connections and lookups run on host
/// threads; the app asks how they are doing from its own loop, as it does a
/// WebSocket, so a stalled server can never freeze a frame.
///
/// An app can also serve (IC-987): `tcp-listen` opens one port the manifest
/// declares as `net.listen:<port>`, and `tcp-accept` hands over each device
/// that connects as a connection that reads, writes and closes like a dialled
/// one. A listener for this computer only needs the declaration; one other
/// devices on the network can open needs the person's yes as well. Every
/// listener closes when the run ends.
interface sockets {
  use types.{net-error};

  /// What became of a lookup started with `lookup`.
  variant lookup-status {
    /// Still asking.
    pending,
    /// The addresses the name stands for, IPv4 and IPv6, as text.
    ready(list<string>),
    /// The name could not be resolved. Retires the handle.
    failed(net-error),
    /// Never issued, or already answered.
    unknown-handle,
  }

  /// What became of a TCP connection started with `tcp-connect`.
  variant connect-status {
    /// Still dialling.
    pending,
    /// Connected, to this address ("ip:port").
    connected(string),
    /// It could not connect, or the connection broke. The handle stays until
    /// `close`.
    failed(net-error),
    /// Never issued, or already closed.
    unknown-handle,
  }

  /// What `tcp-read` found.
  variant read-result {
    /// Bytes that arrived, in order. Never empty.
    data(list<u8>),
    /// Nothing new; the connection is open. Ask again later.
    pending,
    /// The other end finished sending; nothing more will arrive.
    closed,
    /// The connection broke, with the reason.
    failed(net-error),
  }

  /// Who may open a listener (IC-987).
  enum listen-scope {
    /// Programs on this computer only: the listener is bound to the loopback
    /// address (127.0.0.1), which nothing outside the computer can reach.
    /// Needs `net.listen:<port>` declared; the person is not asked.
    this-computer,
    /// Other devices on the same network too: tablets on a factory floor,
    /// the lab's other computers. Needs `net.listen:<port>` declared and the
    /// person's yes ("let other devices on your network open this app on
    /// port N").
    local-network,
  }

  /// Why a listener could not be opened or used. Every case but
  /// `unknown-handle` carries words to show the person.
  variant listen-error {
    /// The manifest does not declare `net.listen:<port>` for this port, the
    /// person did not let other devices in, or the organisation that manages
    /// the computer does not allow it. The words name the capability.
    not-allowed(string),
    /// Another program on this computer, or another listener of this app,
    /// already listens on the port.
    in-use(string),
    /// The port is below 1024, which belongs to the system.
    bad-port(string),
    /// This app already holds as many listeners, or as many connections from
    /// other devices, as it may at once. Close one first.
    too-many(string),
    /// Listening is not possible here: a browser tab or a phone.
    unavailable(string),
    /// Never issued, already closed, or not a listener.
    unknown-handle,
    /// The system refused, with its reason.
    failed(string),
  }

  /// One datagram that arrived on a UDP socket.
  record datagram {
    /// The sender's address, as an IP.
    host: string,
    /// The sender's port.
    port: u16,
    /// The payload.
    data: list<u8>,
  }

  /// Start looking a name up. Allowed when some `net.connect` grant names
  /// this host, on any port. Returns at once; ask `poll-lookup`.
  lookup: func(host: string) -> result<u64, net-error>;

  /// How a lookup is doing. A terminal answer retires the handle.
  poll-lookup: func(handle: u64) -> lookup-status;

  /// Start a TCP connection to a host (a name or an IP) and port. The grant
  /// is checked here, before anything dials. Returns a handle at once.
  tcp-connect: func(host: string, port: u16) -> result<u64, net-error>;

  /// How a connection is doing.
  tcp-status: func(handle: u64) -> connect-status;

  /// Queue bytes to send. Returns how many were taken, which is fewer than
  /// given (even 0) when the connection's queue is full: send the rest later.
  /// Bytes written while still connecting are sent once connected.
  tcp-write: func(handle: u64, bytes: list<u8>) -> result<u32, net-error>;

  /// Take up to `max-bytes` of what has arrived. Never blocks.
  tcp-read: func(handle: u64, max-bytes: u32) -> read-result;

  /// Open a UDP socket on a port the host picks. Sending is what the grants
  /// judge, so binding needs none. `ipv6` asks for an IPv6 socket.
  udp-bind: func(ipv6: bool) -> result<u64, net-error>;

  /// The local port a UDP socket was given.
  udp-local-port: func(handle: u64) -> result<u16, net-error>;

  /// Send one datagram to a host (a name or an IP) and port, judged against
  /// the grants like a connection. Datagrams are best effort: a full send
  /// queue drops this one and says so.
  udp-send: func(handle: u64, host: string, port: u16, data: list<u8>) -> result<_, net-error>;

  /// The next datagram that arrived from an address this socket has sent
  /// to, or none. Never blocks.
  udp-receive: func(handle: u64) -> option<datagram>;

  /// Listen for TCP connections on `port` (IC-987). Only a port the
  /// manifest declares as `net.listen:<port>`, never one below 1024, and
  /// never one something else already listens on. `this-computer` binds the
  /// loopback address and needs only the declaration; `local-network` binds
  /// every address of this computer and needs the person's yes too.
  /// Returns a listener handle at once.
  tcp-listen: func(port: u16, scope: listen-scope) -> result<u64, listen-error>;

  /// The next connection waiting on a listener, or none. Never blocks: ask
  /// from the app's loop. The handle it returns is a connection like one
  /// `tcp-connect` made: `tcp-status` says who connected, `tcp-read`,
  /// `tcp-write` and `close` work on it. At most 32 connections from other
  /// devices are open at once; past that this answers `too-many` and the
  /// device waits until the app closes one.
  tcp-accept: func(listener: u64) -> result<option<u64>, listen-error>;

  /// The local port of a listener or a connected TCP connection.
  tcp-local-port: func(handle: u64) -> result<u16, listen-error>;

  /// Close a TCP connection, a UDP socket or a listener. Safe on a handle
  /// already closed. Closing a listener leaves the connections it accepted
  /// open until each is closed or the run ends.
  close: func(handle: u64);
}
