package krate:fs@0.1.0;

/// Shared filesystem records, modes, and errors.
interface types {
  /// Metadata returned for files and directories.
  record file-stat {
    /// Size in bytes for files. Directory size is host-defined.
    size: u64,
    /// Last modified time in Unix epoch milliseconds.
    modified-millis: u64,
    /// True when the path is a directory.
    is-dir: bool,
  }

  /// How a file should be opened.
  variant open-mode {
    /// Open for reads.
    read,
    /// Open for writes, creating or truncating according to host policy.
    write,
    /// Open for both reads and writes.
    read-write,
    /// Open for appending writes.
    append,
  }

  /// Filesystem error shape used by path and file-handle calls.
  variant fs-error {
    /// Path does not exist.
    not-found,
    /// Capability policy or sandbox rules denied the operation.
    permission-denied,
    /// The target already exists.
    already-exists,
    /// Path text is not accepted by the Phase 2 path rules.
    invalid-path,
    /// Operation needed a directory but found something else.
    not-a-directory,
    /// Operation needed a file but found a directory.
    is-a-directory,
    /// Host-specific filesystem error text.
    io(string),
  }
}

/// Filesystem functions and file resources.
interface files {
  use types.{file-stat, open-mode, fs-error};

  /// Open file resource.
  resource file {
    /// Read up to `n` bytes from the current file cursor.
    read: func(n: u32) -> result<list<u8>, fs-error>;
    /// Write bytes at the current file cursor.
    write: func(bytes: list<u8>) -> result<u32, fs-error>;
    /// Seek to an absolute byte position.
    seek-set: func(pos: u64) -> result<u64, fs-error>;
    /// Seek to the end of the file.
    seek-end: func() -> result<u64, fs-error>;
    /// Read metadata for this open file handle.
    stat: func() -> result<file-stat, fs-error>;
  }

  /// Open a path and return a file resource.
  open: func(path: string, mode: open-mode) -> result<file, fs-error>;

  /// Open a file the person chose in a dialog, by its token.
  ///
  /// The counterpart to `ui.dialog.open-file`. It takes a token rather than a
  /// path because the app never learns the path: the person's click granted
  /// this one file, not the folder it happens to sit in, and handing over a
  /// path would let the app walk to its siblings.
  ///
  /// A token belongs to one run. It is refused after the run that produced it,
  /// so an app cannot store one and come back later for a file nobody offered
  /// again.
  open-chosen: func(token: string, mode: open-mode) -> result<file, fs-error>;
  /// Read metadata for a path without opening it as a file resource.
  stat: func(path: string) -> result<file-stat, fs-error>;
  /// List directory entry names for a path.
  %list: func(path: string) -> result<list<string>, fs-error>;
  /// Remove one file.
  remove-file: func(path: string) -> result<_, fs-error>;
  /// Remove one directory.
  remove-dir: func(path: string) -> result<_, fs-error>;
  /// Create one directory.
  mkdir: func(path: string) -> result<_, fs-error>;
  /// Rename or move a path.
  rename: func(%from: string, to: string) -> result<_, fs-error>;
}

/// Noticing when the files in a folder change: a folder of photos to shrink,
/// a notes folder another editor also writes, an inbox a scanner fills.
///
/// A watch sees what listing the folder would see and nothing more, so it
/// needs what listing needs: `fs.list` on the folder, or a folder the
/// person picked (`picked/<token>/...`). Changes are found by looking, not
/// pushed, which is the same on every system and cannot fall behind.
interface watch {
  use types.{fs-error};

  /// What happened to one path.
  enum change-kind {
    /// It appeared.
    created,
    /// Its size or modified time changed.
    modified,
    /// It went away. A rename is a removal and a creation.
    removed,
  }

  /// One change: the watched folder's path joined with the entry's path
  /// inside it, `/`-separated -- a path the app can pass straight back to
  /// `files.open` or `files.stat`.
  record change {
    /// Where it happened, as the app would name it.
    path: string,
    /// What happened to it.
    kind: change-kind,
    /// True when the path is a folder.
    is-dir: bool,
  }

  /// Start watching a folder and everything under it, and return an id for
  /// `changes`. At most 8 watches at once, and 20,000 entries each: a
  /// bigger tree is refused rather than watched in part.
  start: func(path: string) -> result<u64, fs-error>;

  /// What changed since `start` or the last call, sorted by path. Looks at
  /// most four times a second: calling sooner returns an empty list, not an
  /// error, so an app may simply ask every frame.
  changes: func(watch-id: u64) -> result<list<change>, fs-error>;

  /// Stop watching. An id that is not watching is ignored.
  stop: func(watch-id: u64);
}
