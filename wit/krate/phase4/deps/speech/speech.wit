package krate:speech@0.1.0;

/// Local speech recognition over audio the app already received.
///
/// The model path resolves inside the app's bundled `assets/` directory. The
/// host never resolves it against the user's filesystem.
interface transcription {
  /// A successful bounded transcription.
  record transcript {
    /// Recognized UTF-8 text.
    text: string,
  }

  /// Error returned while validating or transcribing audio.
  variant speech-error {
    /// The PCM shape, sample rate, or language was invalid.
    invalid-request(string),
    /// The requested model is not present in the app bundle.
    model-not-found,
    /// The bundled model could not be loaded.
    model-invalid(string),
    /// The host build does not provide local transcription.
    unsupported(string),
    /// The local model could not transcribe this audio.
    inference(string),
  }

  /// Compact error for latency-sensitive script matching.
  enum match-error {
    /// The PCM shape, sample rate, language, or line was invalid.
    invalid-request,
    /// The requested model is not present in the app bundle.
    model-not-found,
    /// The bundled model could not be loaded.
    model-invalid,
    /// The host build does not provide local transcription.
    unsupported,
    /// The local model could not recognize this audio.
    inference,
  }

  /// Transcribe mono signed 16-bit little-endian PCM with a bundled model.
  transcribe: func(
    model-asset: string,
    pcm-s16-le: list<u8>,
    sample-rate: u32,
    language: option<string>,
  ) -> result<transcript, speech-error>;

  /// Return a 0 to 100 word-overlap score for one expected script line.
  ///
  /// The transcript stays inside the runtime and the guest receives only a
  /// bounded score.
  match-line: func(
    model-asset: string,
    pcm-s16-le: list<u8>,
    sample-rate: u32,
    language: option<string>,
    expected: string,
  ) -> result<u8, match-error>;

  /// Add one bounded audio chunk to the current utterance.
  ///
  /// The runtime owns the growing buffer, so a portable guest does not need a
  /// large allocation. When `finish` is true, the runtime transcribes the
  /// accumulated audio, returns its match score, and clears the utterance.
  match-line-stream: func(
    model-asset: string,
    pcm-s16-le: list<u8>,
    sample-rate: u32,
    language: option<string>,
    expected: string,
    finish: bool,
  ) -> result<option<u8>, match-error>;
}

/// Speaking text aloud with the voices the computer already has.
///
/// Speech is sound, so it is allowed wherever sound is: `audio.playback`,
/// which every app has unless the person takes it away. Nothing is
/// downloaded and nothing leaves the computer.
interface synthesis {
  /// One voice the computer offers.
  record voice {
    /// Pass this to `say` to use the voice.
    id: string,
    /// The name a person would recognise, such as "Daniel".
    name: string,
    /// BCP 47 language tag, such as "en-GB".
    language: string,
  }

  /// Error returned by a speech call.
  variant say-error {
    /// The app may not make sound: `audio.playback` was taken away.
    permission-denied,
    /// Empty text, text over 4,000 characters, an unknown voice id, or a
    /// rate outside 0.5 to 2.0.
    invalid-request(string),
    /// This computer has no speech voices Krate can use.
    unsupported(string),
    /// The system's speech service failed.
    platform(string),
  }

  /// The voices this computer offers, in the order it lists them.
  voices: func() -> result<list<voice>, say-error>;

  /// Start saying `text` and return at once; the speech plays on its own.
  ///
  /// Anything this app was still saying stops first, so a new line replaces
  /// the old one rather than queueing behind it. `voice` is an id from
  /// `voices`; none means the system's default. `rate` is a multiple of the
  /// normal speed, 0.5 to 2.0; none means normal.
  say: func(text: string, voice: option<string>, rate: option<f32>) -> result<_, say-error>;

  /// Stop speaking now. Stopping when nothing is being said is not an error.
  stop: func() -> result<_, say-error>;

  /// Whether this app's speech is still sounding.
  speaking: func() -> result<bool, say-error>;
}
