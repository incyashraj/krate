package krate:gfx@0.1.0;

/// Shared graphics records and errors for Phase 3 drawing calls.
interface types {
  /// RGBA color in linear float form.
  record color {
    /// Red channel.
    r: f32,
    /// Green channel.
    g: f32,
    /// Blue channel.
    b: f32,
    /// Alpha channel.
    a: f32,
  }

  /// Point in logical pixels.
  record point {
    /// X coordinate.
    x: f32,
    /// Y coordinate.
    y: f32,
  }

  /// Size in logical pixels.
  record size {
    /// Width.
    width: f32,
    /// Height.
    height: f32,
  }

  /// Rectangle in logical pixels.
  record rect {
    /// Left edge.
    x: f32,
    /// Top edge.
    y: f32,
    /// Width.
    width: f32,
    /// Height.
    height: f32,
  }


  /// Error shape returned by graphics calls.
  variant gfx-error {
    /// Capability policy or sandbox rules denied the operation.
    permission-denied,
    /// The target window, widget, canvas, or surface is unknown.
    invalid-target,
    /// The host cannot support this graphics feature yet.
    unsupported(string),
    /// Host-specific graphics error text.
    platform(string),
  }




  /// GPU surface options.
  record surface-options {
    /// Preferred width in physical pixels.
    width: u32,
    /// Preferred height in physical pixels.
    height: u32,
    /// Whether presentation should wait for vertical sync.
    vsync: bool,
  }
}

/// 2D drawing calls for widget-backed canvases.
///
/// One call per drawing operation, deliberately. The first shape of this
/// interface batched commands as `submit(list<draw-command>)`, and a list of
/// variants is the one construct current guest toolchains cannot lower
/// without dragging std's panic machinery -- and with it the whole `wasi:*`
/// import surface -- into an otherwise pure component. One `submit` call took
/// a clean guest from zero wasi imports to thirty-three. The events interface
/// learned this first and is single-event for the same reason.
///
/// Nothing appears until `present`: draw calls mutate a host-side raster, and
/// `present` publishes it to the widget. That keeps a hundred fills from
/// re-rendering the window a hundred times.
interface canvas2d {
  use types.{color, point, rect, gfx-error};

  /// Create or bind a 2D canvas for a window widget.
  bind: func(window: u64, widget: u64) -> result<u64, gfx-error>;
  /// Fill the whole canvas with one color.
  clear: func(canvas: u64, fill: color) -> result<_, gfx-error>;
  /// Fill a rectangle.
  fill-rect: func(canvas: u64, area: rect, fill: color) -> result<_, gfx-error>;
  /// Stroke a rectangle's edges.
  stroke-rect: func(canvas: u64, area: rect, stroke: color, width: f32) -> result<_, gfx-error>;
  /// Draw one text run with the host's built-in face; `origin` is the baseline.
  draw-text: func(canvas: u64, text: string, origin: point, font-size: f32, ink: color) -> result<_, gfx-error>;
  /// Draw decoded RGBA pixels into a rectangle, scaled to fit and centred.
  ///
  /// The same straight-RGBA bytes an image widget takes, so a sprite sheet is
  /// decoded once in the sandbox and drawn many times. Transparent pixels blend
  /// over what is already on the canvas, which is what makes a sprite a sprite
  /// rather than a rectangle with a picture in it.
  draw-pixels: func(canvas: u64, area: rect, width: u32, height: u32, rgba: list<u8>) -> result<_, gfx-error>;
  /// Publish the raster to the widget. Until this, nothing is shown.
  present: func(canvas: u64) -> result<_, gfx-error>;
}

/// Minimal 3D surface calls for later WebGPU-shaped work.
interface gpu3d {
  use types.{gfx-error, surface-options};

  /// Create or bind a GPU surface for a window widget.
  create-surface: func(window: u64, widget: u64, options: surface-options) -> result<u64, gfx-error>;
  /// Present the current frame for a surface.
  present: func(surface: u64) -> result<_, gfx-error>;
}
