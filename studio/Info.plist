<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS refuses camera and microphone access to any process whose bundle
	     does not declare why it wants them, and it does so by terminating the
	     process rather than returning an error. The Studio runs the apps it
	     builds, so an app that asks for the camera needs these here. The
	     entitlements file already allows both; these are the sentences the
	     person reads in the system prompt. -->
	<key>NSCameraUsageDescription</key>
	<string>Krate uses the camera only for apps that request camera access and only after you allow it.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Krate adds a picture to your Photos only when an app asks and you allow it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Krate turns what you say into text in the box you are typing in, so you can describe an app out loud.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Krate uses the microphone only for apps that request audio capture and only after you allow it.</string>
	<!-- macOS 26 offers "Fill code, From Messages" in every focused text
	     field for three minutes after a code arrives, with no close button,
	     and the Studio prompt box got it. Nothing in the Studio asks for a
	     one-time code (sign-in is a browser link), so the menu appears only
	     in a field marked as a one-time-code field, and we have none. -->
	<key>NSAutoFillRequiresTextContentTypeForOneTimeCodeOnMac</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.krate.studio.signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>krate</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
