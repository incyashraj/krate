{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krate",
  "version": "0.1.0",
  "identifier": "dev.krate.studio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Krate",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://hub.krate.tech https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Make an app. Send the file. It opens anywhere.",
    "longDescription": "Krate Studio: describe the app you want in plain words, an AI writes it, and you get one small file that runs on Mac, Windows and Linux and can be sent to anyone.",
    "resources": [
      "bin/*"
    ],
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "krate"
        ],
        "name": "Krate App Bundle",
        "description": "An app made with Krate",
        "role": "Viewer",
        "mimeType": "application/vnd.krate.bundle"
      }
    ]
  }
}
