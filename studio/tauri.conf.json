{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krate",
  "version": "0.1.0",
  "identifier": "dev.krate.studio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Krate",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Describe an app. Watch it become real.",
    "longDescription": "Krate Studio: describe the app you want in plain words, an AI writes it, and you get one small file that runs on Mac, Windows and Linux and can be sent to anyone.",
    "resources": [
      "bin/krate"
    ],
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}