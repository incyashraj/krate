# Copy to config.env (ignored by git) and set the paths. Every value used is
# copied into the run directory as config.snapshot.env.

# Obsidian: the official DMG and where install-obsidian.sh puts the app.
OBSIDIAN_DMG="$HOME/krate-bench/obsidian/Obsidian-1.15.1.dmg"
OBSIDIAN_DMG_SHA256=e05c7e3e2262b14c965bb246dcb74a30fc9098bd669e42957c4d9f788d04fdf4
OBSIDIAN_VERSION=1.15.1
OBSIDIAN_APP="$HOME/krate-bench/apps/Obsidian-1.15.1/Obsidian.app"

# Krate: the public release binary, and the Vault app packed as a .krate.
KRATE_BIN="$HOME/.local/bin/krate"
KRATE_VERSION=0.6.1
KRATE_VAULT_BUNDLE="$HOME/krate-bench/vault.krate"
# The Krate installer as downloaded from krate.tech, and every path the
# installed Krate occupies (colon separated), for the size leg.
KRATE_INSTALLER="$HOME/Downloads/Krate-0.6.1.dmg"
KRATE_INSTALLED_PATHS="/Applications/Krate.app:$HOME/.local/bin/krate"
# Grants for an automated Vault run (apps/krate-vault/manifest.toml).
KRATE_VAULT_GRANTS="ui.window:create ui.dialog:open-folder store.kv io.stdout io.args fs.read:./vault/** fs.list:./vault/** fs.write:./vault/** fs.mkdir:./vault/** fs.remove:./vault/**"

# Where profiles and vault copies go during a run (made *.noindex).
BENCH_WORK_DIR="$HOME/krate-bench/work"

# What runs: every leg of PROTOCOL.md (about 4.5 h). Drop growth for a
# shorter rehearsal (about 2.5 h; the audit then says growth was not run).
# Optional, add by hand: energy (needs sudo -v first), battery (on battery, 1 h).
BENCH_LEGS="size startup resources network interaction growth"
BENCH_LOADS="light medium heavy big-50000 big-200000"

# Sample counts (PROTOCOL.md section 5). Lower only for a rehearsal: the
# audit refuses a run below these.
BENCH_WARMUPS=2
BENCH_WARM_RUNS=10
BENCH_COLD_RUNS=5
BENCH_RESOURCE_RUNS=3
BENCH_SETTLE_SECONDS=30
BENCH_IDLE_SECONDS=120
BENCH_NETWORK_SECONDS=60
BENCH_GROWTH_MINUTES=60
BENCH_INTERACT_LOADS="light heavy"
BENCH_INTERACT_RUNS=10
BENCH_TYPING_RUNS=3
BENCH_TYPING_KEYS=30
BENCH_SCROLL_RUNS=3
BENCH_SCROLL_SECONDS=20
BENCH_SCROLL_HZ=125
BENCH_BATTERY_MINUTES=30
BENCH_WINDOW_W=1280
BENCH_WINDOW_H=800
